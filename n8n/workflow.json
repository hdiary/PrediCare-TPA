        "respondWith": "json",
        "responseBody": "={{ { status: 'no_alert', invoice_id: $json.invoice_id, fraud_score: $json.fraud_score, threshold: $json.threshold } }}",
        "options": { "responseCode": 200 }
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Répondre sans alerte",
      "type": "n8n-nodes-base.respondToWebhook",
