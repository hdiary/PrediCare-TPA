# Copy to .env and fill in. NEVER commit .env (only this example).
# POSTGRES_USER=predicare
# POSTGRES_PASSWORD=
# POSTGRES_DB=predicare

# Fernet key for the identities:  python encrypt_identities.py --gen-key
# LOSING IT MAKES THE IDENTITIES UNREADABLE FOREVER: back it up outside Git.
IDENTITY_KEY=
IDENTITY_KEY_VERSION=1

# HMAC key for pseudonymising NEW insured persons:  python pseudo.py --gen-key
PSEUDO_KEY=

# Set to 0 only for local tests on a Postgres without pgvector
PGVECTOR_REQUIRED=1
