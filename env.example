# =============================================================
# PrediCare TPA - Configuration (copier en .env puis adapter)
#   cp .env.example .env
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).
# Remplacez chaque valeur "change_me" ; générez les clés avec :
#   openssl rand -hex 32
# =============================================================

# --- Base de données (PostgreSQL + pgvector) -------------------
POSTGRES_DB=predicare
POSTGRES_USER=predicare_admin
POSTGRES_PASSWORD=change_me
# Mots de passe des rôles à droits limités (créés par la migration d'initialisation)
DB_BI_RO_PASSWORD=change_me
DB_ML_RO_PASSWORD=change_me
DB_AGENT_RO_PASSWORD=change_me

# --- Sécurité et RGPD ------------------------------------------
JWT_SECRET=change_me
JWT_EXPIRE_MINUTES=60
# Clé secrète de la pseudonymisation (HMAC) : ne jamais la perdre ni la changer
PSEUDO_HMAC_KEY=change_me
# Clé de chiffrement de la table d'identités
IDENTITY_ENCRYPTION_KEY=change_me

# --- API (FastAPI) ---------------------------------------------
# Origine autorisée du frontend (CORS)
CORS_ORIGINS=http://localhost:3000
# Seuil d'alerte initial ; modifiable ensuite depuis l'écran d'administration
ALERT_THRESHOLD=0.8

# --- LLM / RAG -------------------------------------------------
LLM_API_KEY=change_me
LLM_MODEL=a_definir
EMBEDDING_MODEL=a_definir

# --- Alertes (n8n) ---------------------------------------------
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
N8N_ENCRYPTION_KEY=change_me

# --- Frontend --------------------------------------------------
# ATTENTION : toute variable NEXT_PUBLIC_* est visible dans le navigateur.
# Aucun secret ici : uniquement l'adresse publique de l'API.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false

# --- BI (Superset, si retenu) ----------------------------------
SUPERSET_SECRET_KEY=change_me
