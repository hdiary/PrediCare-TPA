# --- Rôles Postgres ---
DB_APP_RW_PASSWORD=dev_app_rw_pwd
DB_IDENTITY_READER_PASSWORD=dev_identity_pwd
DB_AGENT_RO_PASSWORD=dev_agent_ro_pwd
DB_BI_RO_PASSWORD=dev_bi_ro_pwd
DB_ML_RO_PASSWORD=dev_ml_ro_pwd

# --- Sauvegardes PostgreSQL ---
# Générer une valeur aléatoire avec :
# node -p "require('crypto').randomBytes(32).toString('hex')"
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400

METABASE_RO_PASSWORD=un_mot_de_passe_fort
MB_ADMIN_EMAIL=admin@predicare.local
MB_ADMIN_PASSWORD=ChangeMe123!
MB_EMBEDDING_SECRET_KEY=une_cle_secrete
# Generate with: node -p "require('crypto').randomBytes(32).toString('hex')"
MB_SESSION_SECRET_KEY=

# --- API ---
JWT_SECRET=cbdf0b301c8f45e529883ddba77e032165aa5274ceb34582bdacf22de5d8b301
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALERT_THRESHOLD=0.7
# Initial API administrator; generate a unique password and keep it secret.
ADMIN_EMAIL=admin@predicare.local
ADMIN_INITIAL_PASSWORD=
# Optional shared password for the professional, insured, and manager demo accounts.
DEMO_PASSWORD=

# --- Création des comptes (admin uniquement) ---
# PSEUDO_HMAC_KEY and IDENTITY_ENCRYPTION_KEY are declared in the key section above.
# Required to deliver new-account credentials. Use a real SMTP relay in deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@predicare.local
SMTP_STARTTLS=true
APP_PUBLIC_URL=http://localhost:5173


# --- API LLM / RAG ---
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=300
# BGE-M3 vectors are stored at 1024 dimensions; use an OpenAI-compatible endpoint.
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_URL=http://host.docker.internal:11434/v1/embeddings
LLM_API_URL=https://api.openai.com/v1/chat/completions
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
CACHE_SIMILARITY_THRESHOLD=0.93
CACHE_TTL_HOURS=24
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# --- n8n / Frontend ---
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=true
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_CHAT=false

MB_EMBEDDING_SECRET_KEY=<résultat de : openssl rand -hex 32>
MB_SITE_URL=http://localhost:3000
